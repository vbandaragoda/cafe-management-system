# Copy this file to .env and adjust before running `docker compose up`.
# .env is read automatically by docker-compose; never commit your real .env.

DB_NAME=caffora
DB_USERNAME=caffora
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_PORT=3306

SERVER_PORT=8080
DDL_AUTO=update

# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET=Tz0N61gU3jhJMER3LMzsf3Suo+MCCLhb1KhHYioMEKk=
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin account created on first startup if it doesn't already exist.
# Log in and change the password immediately in a real deployment.
ADMIN_SEED_EMAIL=admin@caffora.com
ADMIN_SEED_PASSWORD=Admin@12345
ADMIN_SEED_NAME=System Admin
